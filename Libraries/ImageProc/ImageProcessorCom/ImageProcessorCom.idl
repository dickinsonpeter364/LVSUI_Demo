// ImageProcessorCom.idl : IDL source for ImageProcessorCom
//

// This file will be processed by the MIDL tool to
// produce the type library (ImageProcessorCom.tlb) and marshalling code.

import "oaidl.idl";
import "ocidl.idl";

[
    object,
    uuid(F88FB73F-CD9F-4D8A-AD18-03F5D1FC213F), // NOTE: VS Generates a unique GUID here. Keep your VS generated one if possible, or use this.
    dual,
    nonextensible,
    pointer_default(unique)
]
interface IImageMatcher : IDispatch
{
    // Locates a template image within a source image.
    // Inputs are raw byte arrays (SAFEARRAY) assuming 8-bit grayscale or BGR.
    // Returns: boolean found, x, y coordinates, and confidence score (0.0 - 1.0)
    [id(1)] HRESULT MatchTemplate(
        [in] SAFEARRAY(unsigned char) sourceImgData,
        [in] LONG srcWidth,
        [in] LONG srcHeight,
        [in] LONG srcChannels,
        [in] SAFEARRAY(unsigned char) templateImgData,
        [in] LONG tmplWidth,
        [in] LONG tmplHeight,
        [in] LONG tmplChannels,
        [out] LONG* matchX,
        [out] LONG* matchY,
        [out] DOUBLE* confidence,
        [out, retval] VARIANT_BOOL* found
    );
};

[
    uuid(BA7750EA-1D98-4E26-80EB-43BB04022F3D), // Lib GUID (VS generates this)
    version(1.0),
]
library ImageProcessorCom
{
    importlib("stdole2.tlb");
    [
        uuid(DFA03317-EC6B-4CF7-9974-68E66E31F904) // Class GUID (VS generates this)
    ]
        coclass ImageMatcher
    {
        [default] interface IImageMatcher;
    };
};