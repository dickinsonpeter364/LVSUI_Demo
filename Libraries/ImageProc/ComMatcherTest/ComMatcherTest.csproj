<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0-windows required for COM interop APIs -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The Interop.OpenCVComMatcherLib.dll is pre-generated from the registered
    OpenCVComMatcher.dll (via tlbimp).  It lives in Libraries/References so
    dotnet build works without needing ResolveComReference / VS MSBuild.

    To regenerate it after changing the COM interface:
      tlbimp "C:\LVSUi\x64\Release\OpenCVComMatcher.dll" /out:"C:\LVSUi\Libraries\References\Interop.OpenCVComMatcherLib.dll"
  -->
  <ItemGroup>
    <Reference Include="Interop.OpenCVComMatcherLib">
      <HintPath>$(MSBuildThisFileDirectory)..\..\References\Interop.OpenCVComMatcherLib.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Packing.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
