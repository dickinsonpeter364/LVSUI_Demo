
// This file will be processed by the MIDL tool to
// produce the type library (OpenCVComMatcher.tlb) and marshalling code.

import "oaidl.idl";
import "ocidl.idl";

[
    object,
    uuid(443CE94F-F9EB-4F5F-8FEA-2E3B0492260D), // NOTE: Use the GUID generated by your Visual Studio project here
    dual,
    nonextensible,
    pointer_default(unique)
]
interface IImageMatcher : IDispatch
{
    // 1. Set the current source image for subsequent operations
    // MUST BE CALLED FIRST before using other methods.
    [id(1)] HRESULT SetSourceImage(
        [in] SAFEARRAY(unsigned char) imgData,
        [in] LONG width,
        [in] LONG height,
        [in] LONG channels,
        [in] BSTR xmlImageDef
    );
    // 2. Standard matching with byte arrays (supports optional Mask)
    // Uses the source image set by SetSourceImage.
    [id(2)] HRESULT MatchTemplate(
        [in] SAFEARRAY(unsigned char) templateImgData,
        [in] LONG tmplWidth,
        [in] LONG tmplHeight,
        [in] LONG tmplChannels,
        [in] SAFEARRAY(unsigned char) maskImgData, // Pass NULL/0 if unused
        [in] LONG maskWidth,
        [in] LONG maskHeight,
        [in] LONG maskChannels,
        [in] LONG searchX,
        [in] LONG searchY,
        [in] LONG searchWidth,
        [in] LONG searchHeight,
        [out] LONG* matchX,
        [out] LONG* matchY,
        [out] DOUBLE* confidence,
        [out, retval] VARIANT_BOOL* found
    );

    // 3. Matching using file paths for Template and Mask
    // Uses the source image set by SetSourceImage.
    [id(3)] HRESULT MatchTemplateFromFile(
        [in] BSTR templateFilePath,
        [in] BSTR maskFilePath, // Pass NULL or empty string if unused
        [in] LONG searchX,
        [in] LONG searchY,
        [in] LONG searchWidth,
        [in] LONG searchHeight,
        [out] LONG* matchX,
        [out] LONG* matchY,
        [out] DOUBLE* confidence,
        [out, retval] VARIANT_BOOL* found
    );

    // 4. Find Data Matrix objects in the stored source image
    // Returns a JSON string array.
    [id(4)] HRESULT GetDataMatrices(
        [out] BSTR* jsonResult,
        [out, retval] VARIANT_BOOL* found
    );
    // 5. NEW: Match multiple templates from a list of files
    // Takes an array of file paths. Returns a JSON string array of matches.
    // JSON Format: [{"index": 0, "path": "...", "x": 100, "y": 200, "confidence": 0.95}, ...]
    [id(5)] HRESULT MatchTemplates(
        [in] SAFEARRAY(BSTR) templateFilePaths,
        [in] LONG searchX,
        [in] LONG searchY,
        [in] LONG searchWidth,
        [in] LONG searchHeight,
        [out] BSTR* jsonResult,
        [out, retval] VARIANT_BOOL* anyFound
    );
    // 6. NEW: Perform OCR on a specific rectangle
 // Treat region as a single line of text (PSM_SINGLE_LINE).
 // language: Tesseract language code (e.g., "eng", "deu").
 // confidence: Returns 0.0 - 1.0 based on Tesseract's confidence score.
    [id(6)] HRESULT PerformOCR(
        [in] BSTR language,
        [in] LONG searchX,
        [in] LONG searchY,
        [in] LONG searchWidth,
        [in] LONG searchHeight,
        [out] BSTR* detectedText,
        [out] DOUBLE* confidence,
        [out, retval] VARIANT_BOOL* success
    );
    // 7. NEW: Set Label Definition (XML) and Source Image
    [id(7)] HRESULT SetLabelDefinition(
        [in] BSTR xmlLabelDef
    );

    // 8. NEW: Perform Match with Key-Value pairs
    [id(8)] HRESULT PerformMatch(
        [in] SAFEARRAY(BSTR) keys,
        [in] SAFEARRAY(BSTR) values,
        [out, retval] VARIANT_BOOL* result
    );

    [id(9)] HRESULT GetMarkedImage(
        [out] SAFEARRAY(unsigned char)* pImgData,
        [out] LONG* width,
        [out] LONG* height,
        [out] LONG* channels
    );
    // 10. Retrieve the Normalised (Processed) Source Image
    [id(10)] HRESULT RetrieveNormalisedImage(
        [out] SAFEARRAY(unsigned char)* pImgData,
        [out] LONG* width,
        [out] LONG* height,
        [out] LONG* channels
    
    );
};
[
    uuid(CBF34F07-E40D-4728-5119-8F2D0F4C03A1),
    version(1.0),
]
library OpenCVComMatcherLib
{
    importlib("stdole2.tlb");
    [
        uuid(456F81F6-6DCC-4DC9-BE23-55A18E67580B) // Class GUID (VS generates this)
    ]
        coclass ImageMatcher
    {
        [default] interface IImageMatcher;
    };
};