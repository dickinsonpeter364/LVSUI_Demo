<Page x:Class="WpfMvvmApp.Views.DeviceControlView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfMvvmApp.Views"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="900"
      Title="Device Control">

    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="White" Padding="20" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Button Command="{Binding GoBackCommand}"
                        Visibility="{Binding CanGoBackVisible, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Left" Width="50" Height="50"
                        Background="Transparent" BorderThickness="0"
                        Content="&lt;" FontSize="24" Foreground="#333"/>
                <TextBlock Text="Device Control" FontSize="24" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#333"/>
            </Grid>
        </Border>

        <!-- Main Controls -->
        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style x:Key="CoreSizeButton" TargetType="Button">
                    <Setter Property="Height" Value="50"/>
                    <Setter Property="Width" Value="80"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#333"/>
                    <Setter Property="BorderBrush" Value="#CCC"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <!-- Row 0: Rewind - Speed - Wind -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,40">

                <!-- Rewind Section -->
                <StackPanel VerticalAlignment="Center" Width="180">
                    <Button Command="{Binding ReverseCommand}"
                            Width="100" Height="100"
                            Foreground="White" FontSize="16" FontWeight="Bold"
                            Content="Rewind">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#007ACC"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReverseRunning}" Value="True">
                                        <Setter Property="Background" Value="#2E7D32"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="100"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <TextBlock Text="Rewind Core" HorizontalAlignment="Center" Margin="0,20,0,5"
                               Foreground="#666" FontWeight="Bold"/>
                    <UniformGrid Columns="2" Width="170">
                        <Button Content="Small" Command="{Binding SetRewindSizeCommand}" CommandParameter="Small">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CoreSizeButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RewindReelSize}" Value="Small">
                                            <Setter Property="Background" Value="#007ACC"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Large" Command="{Binding SetRewindSizeCommand}" CommandParameter="Large" Margin="10,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CoreSizeButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RewindReelSize}" Value="Large">
                                            <Setter Property="Background" Value="#007ACC"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <!-- Speed Control -->
                <StackPanel Margin="40,0" VerticalAlignment="Top" Width="300">
                    <TextBlock HorizontalAlignment="Center" Margin="0,0,0,10" FontSize="18" FontWeight="Bold" Foreground="#555">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Speed: {0:F0}">
                                <Binding Path="Speed"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Slider Minimum="10" Maximum="154" Value="{Binding Speed}"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            Height="40"/>
                    <Grid Margin="0,5,0,0">
                        <TextBlock Text="10" HorizontalAlignment="Left" Foreground="#888"/>
                        <TextBlock Text="154" HorizontalAlignment="Right" Foreground="#888"/>
                    </Grid>
                </StackPanel>

                <!-- Wind Section -->
                <StackPanel VerticalAlignment="Center" Width="180">
                    <Button Command="{Binding ForwardCommand}"
                            Width="100" Height="100"
                            Foreground="White" FontSize="16" FontWeight="Bold"
                            Content="Wind">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#007ACC"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsForwardRunning}" Value="True">
                                        <Setter Property="Background" Value="#2E7D32"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="100"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <TextBlock Text="Wind Core" HorizontalAlignment="Center" Margin="0,20,0,5"
                               Foreground="#666" FontWeight="Bold"/>
                    <UniformGrid Columns="2" Width="170">
                        <Button Content="Small" Command="{Binding SetWindSizeCommand}" CommandParameter="Small">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CoreSizeButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindReelSize}" Value="Small">
                                            <Setter Property="Background" Value="#007ACC"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Large" Command="{Binding SetWindSizeCommand}" CommandParameter="Large" Margin="10,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CoreSizeButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindReelSize}" Value="Large">
                                            <Setter Property="Background" Value="#007ACC"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </StackPanel>

            <!-- Row 1: Stop and Alarm Reset -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Button Command="{Binding StopCommand}"
                        Width="200" Height="80"
                        Foreground="White" FontSize="24" FontWeight="Bold"
                        Content="STOP">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#888"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Background" Value="#D32F2F"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Command="{Binding ResetAlarmCommand}"
                        Width="200" Height="80"
                        Foreground="White" FontSize="18" FontWeight="Bold"
                        Content="RESET ALARM" Margin="20,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#888"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAlarm}" Value="True">
                                    <Setter Property="Background" Value="#D32F2F"/>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- Row 2: Continue to Inspection (PostLogin mode only) -->
            <Button Grid.Row="2" Command="{Binding ContinueToInspectionCommand}"
                    Width="300" Height="60"
                    Background="#007ACC" Foreground="White"
                    FontSize="20" FontWeight="Bold"
                    Content="Continue to Inspection"
                    Margin="0,20,0,0"
                    Visibility="{Binding IsPostLoginMode, Converter={StaticResource BoolToVis}}">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#333" Padding="15,10">
            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Page>
