<Page x:Class="WpfMvvmApp.Views.DeviceControlView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfMvvmApp.Views"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Device Control">

    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="White" Padding="20" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Button Command="{Binding GoBackCommand}" HorizontalAlignment="Left" Width="50" Height="50" Background="Transparent" BorderThickness="0" Content="&lt;" FontSize="24" Foreground="#333"/>
                <TextBlock Text="Device Control" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#333"/>
            </Grid>
        </Border>

        <!-- Controls Area -->
        <Grid Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Row: Rewind - Speed - Wind -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,50">
                
                <!-- Rewind -->
                <Button Command="{Binding RewindCommand}"
                        Width="100" Height="100"
                        Background="#007ACC" Foreground="White"
                        FontSize="16" FontWeight="Bold"
                        Content="Rewind">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="100"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Speed Control -->
                <StackPanel Margin="30,0" VerticalAlignment="Center" Width="300">
                    <TextBlock Text="{Binding Speed, StringFormat='Speed: {0:F0}%'}" 
                               HorizontalAlignment="Center" Margin="0,0,0,10" 
                               FontSize="18" FontWeight="SemiBold" Foreground="#555"/>
                    <Slider Minimum="0" Maximum="100" Value="{Binding Speed}" 
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            Height="40"/>
                    <Grid Margin="0,5,0,0">
                        <TextBlock Text="0%" HorizontalAlignment="Left" Foreground="#888"/>
                        <TextBlock Text="100%" HorizontalAlignment="Right" Foreground="#888"/>
                    </Grid>
                </StackPanel>

                <!-- Wind -->
                 <Button Command="{Binding WindCommand}"
                        Width="100" Height="100"
                        Background="#007ACC" Foreground="White"
                        FontSize="16" FontWeight="Bold"
                        Content="Wind">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="100"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- Bottom Row: Stop -->
            <Button Grid.Row="1" 
                    Command="{Binding StopCommand}"
                    Width="150" Height="80"
                    Background="#D32F2F" Foreground="White"
                    FontSize="24" FontWeight="Bold"
                    Content="STOP"
                    HorizontalAlignment="Center">
                 <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Page>
