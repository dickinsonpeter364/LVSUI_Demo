<Window x:Class="WpfMvvmApp.Views.PreInspectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pre-Inspection Settings"
        Width="550" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#F0F0F0">

    <Window.Resources>
        <Style x:Key="CoreSizeButton" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Review and adjust settings before starting inspection"
                   FontSize="16" FontWeight="SemiBold" Foreground="#333"
                   TextWrapping="Wrap" Margin="0,0,0,25"/>

        <!-- Speed Control -->
        <StackPanel Grid.Row="1" Margin="0,0,0,25">
            <TextBlock FontSize="16" FontWeight="Bold" Foreground="#555" Margin="0,0,0,8">
                <TextBlock.Text>
                    <MultiBinding StringFormat="Speed: {0:F0}">
                        <Binding Path="Speed" RelativeSource="{RelativeSource AncestorType=Window}"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <Slider x:Name="SpeedSlider" Minimum="10" Maximum="154"
                    Value="{Binding Speed, RelativeSource={RelativeSource AncestorType=Window}}"
                    TickFrequency="1" IsSnapToTickEnabled="True" Height="30"
                    ValueChanged="OnValueChanged"/>
            <Grid Margin="0,3,0,0">
                <TextBlock Text="10" HorizontalAlignment="Left" Foreground="#888" FontSize="12"/>
                <TextBlock Text="154" HorizontalAlignment="Right" Foreground="#888" FontSize="12"/>
            </Grid>
        </StackPanel>

        <!-- Rewind Core Size -->
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="Rewind Core Size" FontSize="14" FontWeight="Bold" Foreground="#555" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RewindSmall" Content="Small" Click="OnRewindSmallClick" Style="{StaticResource CoreSizeButton}"/>
                <Button x:Name="RewindLarge" Content="Large" Click="OnRewindLargeClick" Style="{StaticResource CoreSizeButton}"/>
            </StackPanel>
        </StackPanel>

        <!-- Wind Core Size -->
        <StackPanel Grid.Row="3" Margin="0,0,0,20">
            <TextBlock Text="Wind Core Size" FontSize="14" FontWeight="Bold" Foreground="#555" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="WindSmall" Content="Small" Click="OnWindSmallClick" Style="{StaticResource CoreSizeButton}"/>
                <Button x:Name="WindLarge" Content="Large" Click="OnWindLargeClick" Style="{StaticResource CoreSizeButton}"/>
            </StackPanel>
        </StackPanel>

        <!-- OK / Cancel -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnOk" Content="OK" Width="100" Height="40" FontSize="16" FontWeight="Bold"
                    Background="#2E7D32" Foreground="White" Margin="0,0,15,0"
                    IsEnabled="False" Click="OnOkClick">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Cancel" Width="100" Height="40" FontSize="16" FontWeight="Bold"
                    Background="#D32F2F" Foreground="White" IsCancel="True">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
