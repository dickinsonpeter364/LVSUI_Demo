<Page x:Class="WpfMvvmApp.Views.InspectionView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WpfMvvmApp.Views"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Inspection">

    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Back button row -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Footer/Buttons -->
        </Grid.RowDefinitions>

        <!-- Back button (alarms now displayed globally in MainWindow) -->
        <Button Grid.Row="0" Command="{Binding GoBackCommand}" Width="40" Height="40"
                HorizontalAlignment="Left"
                Background="Transparent" BorderThickness="0" Content="&lt;" FontSize="22" Foreground="#333"
                Margin="10,5,0,0"/>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="7*"/>
            </Grid.ColumnDefinitions>

            <!-- Video Box and Information Panel -->
            <Grid Grid.Column="0" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Backing Camera" FontSize="18" FontWeight="Bold" Foreground="#444" Margin="0,0,0,5" HorizontalAlignment="Center"/>

                <Border Grid.Row="1" BorderBrush="#999" BorderThickness="1" Background="Black" Margin="0,0,0,10">
                    <Image Source="{Binding LatestImage}" Stretch="Uniform"/>
                </Border>

                <!-- Information Panel -->
                <TextBlock Grid.Row="2" Text="Information" FontSize="18" FontWeight="Bold" Foreground="#444" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                <TextBox Grid.Row="3" Text="{Binding InfoText, Mode=OneWay}" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                         Padding="10" FontSize="14" BorderBrush="#999" Background="White"/>
            </Grid>

            <!-- Picture Box Area -->
            <Grid Grid.Column="1" Margin="10">
                 <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                 <TextBlock Grid.Row="0" Text="Current Label" FontSize="18" FontWeight="Bold" Foreground="#444" Margin="0,0,0,5" HorizontalAlignment="Center"/>

                 <Border Grid.Row="1" BorderBrush="#999" BorderThickness="1" Background="White">
                     <Viewbox Stretch="Fill">
                         <Grid Width="320" Height="180" Background="White">
                             <Path Data="M10,90 L60,40 L110,90 M100,70 L150,20 L200,70 M-10,190 L330,190" Stroke="#CCC" StrokeThickness="2" Stretch="Uniform" Margin="20"/>
                             <TextBlock Text="LABEL-12345" FontSize="20" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                         </Grid>
                     </Viewbox>
                 </Border>
            </Grid>

        </Grid>

        <!-- Bottom Buttons -->
        <Grid Grid.Row="2" Margin="0,0,0,40">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <Button Command="{Binding StartCommand}" Content="START"
                        Width="140" Height="60" FontSize="18" FontWeight="Bold"
                        Background="#2E7D32" Foreground="White" Margin="0,0,20,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Command="{Binding StopCommand}" Content="Cancel Inspection"
                        Width="200" Height="60" FontSize="18" FontWeight="Bold"
                        Background="#D32F2F" Foreground="White" Margin="0,0,20,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Command="{Binding ViewAuditTrailCommand}" Content="View Audit Trail"
                         Width="180" Height="60" FontSize="18" FontWeight="SemiBold"
                         Background="#795548" Foreground="White" Margin="0,0,20,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- DEBUG: Remove before release -->
                <Button Command="{Binding SimulateAlarmCommand}" Content="Simulate Alarm"
                         Width="180" Height="60" FontSize="18" FontWeight="SemiBold"
                         Background="#9C27B0" Foreground="White"
                         ToolTip="Click 1: test binding. Click 2: test full alarm chain.">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

            </StackPanel>
        </Grid>
    </Grid>
</Page>
