<Page x:Class="WpfMvvmApp.Views.LpnEntryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfMvvmApp.Views"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="LPN Entry"
      FocusManager.FocusedElement="{Binding ElementName=LpnTextBox}">

    <Grid Background="#F0F0F0">
        <Border Background="White" CornerRadius="10" Padding="40" VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.2"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Enter LPN Number" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="#333"/>

                <TextBlock Text="LPN Number" FontSize="16" Foreground="#666" Margin="0,0,0,5"/>
                <TextBox x:Name="LpnTextBox" Text="{Binding LpnNumber, UpdateSourceTrigger=PropertyChanged}" 
                         FontSize="20" Padding="10" Height="50" Margin="0,0,0,40" 
                         VerticalContentAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="OK" 
                            IsDefault="True"
                            Command="{Binding OkCommand}" 
                            Width="150" Height="50" FontSize="18" FontWeight="SemiBold"
                            Background="#007ACC" Foreground="White" BorderThickness="0"
                            Margin="0,0,20,0">
                         <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="Cancel" 
                            Command="{Binding CancelCommand}" 
                            Width="150" Height="50" FontSize="18" FontWeight="SemiBold"
                            Background="#E0E0E0" Foreground="#333" BorderThickness="0">
                         <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
