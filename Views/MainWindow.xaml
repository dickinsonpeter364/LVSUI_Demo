<Window x:Class="WpfMvvmApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfMvvmApp.Views"
        mc:Ignorable="d"
        Title="Label Verification System" WindowState="Maximized" WindowStyle="None" ResizeMode="NoResize">
    <DockPanel LastChildFill="True">
        <!-- Top Header Area (Shared across all pages) -->
        <Border DockPanel.Dock="Top" Background="#333" Height="60" Padding="10,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <!-- Use pack URI for reliability -->
                    <Image Source="pack://application:,,,/Images/logo.png" 
                           Stretch="Uniform" 
                           Width="105" Height="50" 
                           Margin="0,0,15,0"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="Label Verification System" 
                               Foreground="White" 
                               VerticalAlignment="Center" 
                               FontWeight="Bold" 
                               FontSize="20"/>
                </StackPanel>

                <Button Content="End Application"
                        Command="{Binding LogOffCommand}"
                        Visibility="{Binding IsLogOffVisible, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="15,5"
                        Background="#D32F2F"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    CornerRadius="4" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#B71C1C"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#8B0000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Global Alarms Bar (shown on every screen) -->
        <Border DockPanel.Dock="Top" Background="#FFF5F5" Padding="15,8"
                BorderBrush="#D32F2F" BorderThickness="0,0,0,1" MinHeight="40">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding AlarmsText, Mode=OneWay}"
                         IsReadOnly="True"
                         HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         FontSize="14" FontWeight="SemiBold" Foreground="#D32F2F"
                         Background="Transparent" BorderThickness="0"
                         VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Cancel Alarms"
                        Command="{Binding CancelAlarmsCommand}"
                        Width="130" Height="30" FontSize="13" FontWeight="SemiBold"
                        Background="#FF9800" Foreground="White" Margin="10,0,0,0"
                        BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Page Navigator -->
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </DockPanel>
</Window>
