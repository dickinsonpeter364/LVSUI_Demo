<Page x:Class="WpfMvvmApp.Views.LabelInvestigationView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfMvvmApp.Views"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Label Investigation">

    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title/Header -->
            <RowDefinition Height="*"/>    <!-- Image -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
            <RowDefinition Height="Auto"/> <!-- Checkboxes -->
            <RowDefinition Height="50"/>   <!-- Bottom Spacing -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Label Investigation" FontSize="28" FontWeight="Bold" Foreground="#333" 
                   HorizontalAlignment="Center" Margin="0,20,0,10"/>

        <!-- Picture Box Area -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Current Label" FontSize="20" FontWeight="SemiBold" Foreground="#444" 
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
            
            <Border Grid.Row="1" BorderBrush="#999" BorderThickness="1" Background="White">
                <Viewbox Stretch="Uniform">
                    <Grid Width="640" Height="360" Background="White">
                         <!-- Placeholder Label Image -->
                         <Rectangle Stroke="#CCC" StrokeThickness="4" RadiusX="10" RadiusY="10" Margin="10"/>
                         <Path Data="M50,180 L150,80 L250,180 M200,140 L300,40 L400,140" Stroke="#EEE" StrokeThickness="5" Margin="20"/>
                         <TextBlock Text="SUSPICIOUS LABEL" FontSize="40" FontWeight="Bold" Foreground="#D32F2F" 
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" RenderTransformOrigin="0.5,0.5">
                             <TextBlock.RenderTransform>
                                 <RotateTransform Angle="-10"/>
                             </TextBlock.RenderTransform>
                         </TextBlock>
                    </Grid>
                </Viewbox>
            </Border>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,20">
            <Button Content="Accept" Command="{Binding AcceptCommand}"
                    Width="160" Height="60" FontSize="20" FontWeight="Bold"
                    Background="#2E7D32" Foreground="White" Margin="0,0,30,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Reject" Command="{Binding RejectCommand}"
                    Width="160" Height="60" FontSize="20" FontWeight="Bold"
                    Foreground="White" Margin="0,0,0,0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#D32F2F"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#FFA0A0A0"/>
                                <Setter Property="Foreground" Value="#FFE0E0E0"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- Checkboxes -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <!-- Transform scale used to make checkboxes larger for touch -->
            <StackPanel.LayoutTransform>
                <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
            </StackPanel.LayoutTransform>
            
            <CheckBox Content="Patch Print" IsChecked="{Binding IsPatchPrint}" Margin="0,0,20,0" VerticalContentAlignment="Center"/>
            <CheckBox Content="Invalid Data" IsChecked="{Binding IsInvalidData}" Margin="0,0,20,0" VerticalContentAlignment="Center"/>
            <CheckBox Content="Other" IsChecked="{Binding IsOther}" VerticalContentAlignment="Center"/>
        </StackPanel>

    </Grid>
</Page>
