<Window x:Class="WpfMvvmApp.Views.CredentialSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oracle Database Credentials"
        Width="420" Height="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Enter Oracle connection details:"
                   FontWeight="SemiBold" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Text="IP Address:" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtIP" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="2" Text="Port:" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtPort" Text="1521" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="3" Text="Service Name:" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtServiceName" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="4" Text="Username:" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtUsername" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="5" Text="Password:" VerticalAlignment="Center" Margin="0,0,0,6"/>
        <PasswordBox Grid.Row="5" Grid.Column="1" x:Name="TxtPassword" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" x:Name="StatusText"
                   Foreground="Gray" FontStyle="Italic" Margin="0,4,0,0" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Test Connection" Width="120" Height="28" Margin="0,0,8,0"
                    Click="OnTestConnection"/>
            <Button Content="Save" Width="80" Height="28" Margin="0,0,8,0"
                    x:Name="BtnSave" IsEnabled="False" Click="OnSave"/>
            <Button Content="Cancel" Width="80" Height="28" IsCancel="True"
                    Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
