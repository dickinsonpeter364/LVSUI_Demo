<Page x:Class="WpfMvvmApp.Views.QcReviewView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfMvvmApp.Views"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="1000"
      Title="QC Review">

    <Grid Background="#F4F7F9">
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </Grid.Resources>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="White" Padding="20" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <TextBlock Text="QC Review" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2C3E50"/>
        </Border>

        <!-- Review Boxes Area -->
        <Grid Grid.Row="1" Margin="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowLaf2}" Value="False">
                                    <Setter Property="Width" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LAF 1 -->
            <Border Grid.Column="0" Margin="10" Background="White" CornerRadius="12" BorderBrush="#D1D8E0" BorderThickness="2">
                <Grid>
                    <TextBlock Text="LAF1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,15,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#7F8C8D"/>
                    <Border Margin="20,50,20,20" Background="#FDFDFD" CornerRadius="8" BorderBrush="#EDEDED" BorderThickness="1">
                         <TextBlock Text="📄" FontSize="80" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"/>
                    </Border>
                </Grid>
            </Border>

            <!-- LAF 2 (Optional) -->
            <Border Grid.Column="1" Margin="10" Background="White" CornerRadius="12" BorderBrush="#D1D8E0" BorderThickness="2"
                    Visibility="{Binding ShowLaf2, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <TextBlock Text="LAF 2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,15,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#7F8C8D"/>
                    <Border Margin="20,50,20,20" Background="#FDFDFD" CornerRadius="8" BorderBrush="#EDEDED" BorderThickness="1">
                        <TextBlock Text="📄" FontSize="80" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Label -->
            <Border Grid.Column="2" Margin="10" Background="White" CornerRadius="12" BorderBrush="#007ACC" BorderThickness="2">
                <Grid>
                    <TextBlock Text="Label" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,15,0,0" FontSize="20" FontWeight="SemiBold" Foreground="#007ACC"/>
                    <Border Margin="20,50,20,20" Background="#FDFDFD" CornerRadius="8" BorderBrush="#EDEDED" BorderThickness="1">
                        <TextBlock Text="🏷️" FontSize="80" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,40">
            <Button Command="{Binding AcceptCommand}"
                    Content="Accept"
                    Width="200" Height="60"
                    Background="#27AE60" Foreground="White"
                    FontSize="22" FontWeight="Bold"
                    Margin="0,0,20,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="30"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Command="{Binding RejectCommand}"
                    Content="Reject"
                    Width="200" Height="60"
                    Background="#E74C3C" Foreground="White"
                    FontSize="22" FontWeight="Bold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="30"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Page>
