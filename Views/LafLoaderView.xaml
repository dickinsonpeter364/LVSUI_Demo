<Page x:Class="WpfMvvmApp.Views.LafLoaderView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfMvvmApp.Views"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="LAF Loader">

    <Grid Background="#1A1A2E">
        <Grid.RowDefinitions>
            <!-- Selection bar -->
            <RowDefinition Height="Auto"/>
            <!-- Qual image panels -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: File selection panel ═══ -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="12"
                Margin="20,20,20,12" Padding="28,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.18" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- LAF 1 label + path box -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- spacer -->
                    <ColumnDefinition Width="32"/>
                    <!-- LAF 2 label + path box -->
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- spacer -->
                    <ColumnDefinition Width="32"/>
                    <!-- Buttons -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LAF 1 -->
                <TextBlock Grid.Column="0" Text="LAF 1" FontSize="15" FontWeight="Bold"
                           Foreground="#333" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox   Grid.Column="1" Text="{Binding Laf1Path}" IsReadOnly="True"
                           FontSize="14" Padding="8,0" Height="40"
                           VerticalContentAlignment="Center" Background="#F5F5F5"
                           BorderBrush="#DDD" BorderThickness="1"/>
                <Button    Grid.Column="2" Content="…" Command="{Binding SelectLaf1Command}"
                           Width="46" Height="40" Margin="6,0,0,0"
                           Background="#EEEEEE" Foreground="#333" BorderThickness="0" FontSize="16">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>

                <!-- LAF 2 -->
                <TextBlock Grid.Column="4" Text="LAF 2" FontSize="15" FontWeight="Bold"
                           Foreground="#333" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox   Grid.Column="5" Text="{Binding Laf2Path}" IsReadOnly="True"
                           FontSize="14" Padding="8,0" Height="40"
                           VerticalContentAlignment="Center" Background="#F5F5F5"
                           BorderBrush="#DDD" BorderThickness="1"/>
                <Button    Grid.Column="6" Content="…" Command="{Binding SelectLaf2Command}"
                           Width="46" Height="40" Margin="6,0,0,0"
                           Background="#EEEEEE" Foreground="#333" BorderThickness="0" FontSize="16">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>

                <!-- OK / Cancel -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="OK" IsDefault="True"
                            Command="{Binding OkCommand}"
                            Width="110" Height="40" FontSize="15" FontWeight="SemiBold"
                            Background="#007ACC" Foreground="White" BorderThickness="0"
                            Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Width="110" Height="40" FontSize="15" FontWeight="SemiBold"
                            Background="#E0E0E0" Foreground="#333" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Row 1: Two large qual image panels ═══ -->
        <Grid Grid.Row="1" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LAF 1 Qual Panel -->
            <Border Grid.Column="0" Background="#0D0D1A" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.4" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <!-- Panel label -->
                    <TextBlock Text="LAF 1 — Quality Preview"
                               Foreground="#607090" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Top" HorizontalAlignment="Left"
                               Margin="14,10,0,0"/>

                    <!-- Placeholder when nothing loaded -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Laf1Preview,
                                    Converter={StaticResource NullToVis},
                                    ConverterParameter=inverse}">
                        <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center"
                                   Foreground="#2A3050"/>
                        <TextBlock Text="Select LAF 1 to load preview"
                                   Foreground="#3A4560" FontSize="15"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Annotated PDF image -->
                    <Image Source="{Binding Laf1Preview}"
                           Stretch="Uniform"
                           Margin="10,32,10,10"
                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Stretch"
                           Visibility="{Binding Laf1Preview, Converter={StaticResource NullToVis}}"/>

                    <!-- Processing spinner overlay -->
                    <Border Background="#99000010" CornerRadius="10"
                            Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="⏳ Processing PDF…"
                                       Foreground="White" FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Column spacer -->
            <Grid Grid.Column="1"/>

            <!-- LAF 2 Qual Panel -->
            <Border Grid.Column="2" Background="#0D0D1A" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.4" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <!-- Panel label -->
                    <TextBlock Text="LAF 2 — Quality Preview"
                               Foreground="#607090" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Top" HorizontalAlignment="Left"
                               Margin="14,10,0,0"/>

                    <!-- Placeholder when nothing loaded -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Laf2Preview,
                                    Converter={StaticResource NullToVis},
                                    ConverterParameter=inverse}">
                        <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center"
                                   Foreground="#2A3050"/>
                        <TextBlock Text="Select LAF 2 to load preview"
                                   Foreground="#3A4560" FontSize="15"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Annotated PDF image -->
                    <Image Source="{Binding Laf2Preview}"
                           Stretch="Uniform"
                           Margin="10,32,10,10"
                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Stretch"
                           Visibility="{Binding Laf2Preview, Converter={StaticResource NullToVis}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
